{
    "devDependencies": {
        "electron": "^25.4.0",
        "electron-builder": "^24.6.3"
    },
    "scripts": {
        "postinstall": "cd app && npm install",
        "build": "npm exec electron-builder"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/MM-Soft-Auto"
    },
    "bugs": {
        "url": "https://github.com/MM-Soft-Auto"
    },
    "overrides": {
        "graceful-fs": "^4.2.10"
    },
    "build": {
        "extraFiles": [
          {
            "from": "../../arduexec",
            "to": "arduexec"
          },
          {
            "from": "../../ardublockly",
            "to": "ardublockly"
          },
          {
            "from": "../../blockly/arduino_compressed.js",
            "to": "blockly/arduino_compressed.js"
          },
          {
            "from": "../../blockly/blockly_uncompressed.js",
            "to": "blockly/blockly_uncompressed.js"
          },
          {
            "from": "../../blockly/blocks_compressed.js",
            "to": "blockly/blocks_compressed.js"
          },
          {
            "from": "../../blockly/msg",
            "to": "blockly/msg"
          },
          {
            "from": "../../blockly/media",
            "to": "blockly/media"
          },
          {
            "from": "../../blockly/core",
            "to": "blockly/core"
          },
          {
            "from": "../../blockly/blocks",
            "to": "blockly/blocks"
          },
          {
            "from": "../../blockly/generators",
            "to": "blockly/generators"
          },
          {
            "from": "../../blocks/blocks_data.json",
            "to": "blocks/blocks_data.json"
          },
          {
            "from": "../../closure-library/closure",
            "to": "closure-library/closure"
          }
        ],
        "win": {
          "icon" : "resources/windows/icon.ico"
        }      
    }
}